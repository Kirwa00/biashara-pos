{
  "name": "kenya-pos",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev:web",
    "dev:api": "npm run dev -w @kpos/api",
    "dev:web": "npm run dev -w @kpos/web",
    "db:migrate": "npm run db:migrate -w @kpos/api",
    "db:seed": "npm run db:seed -w @kpos/api"
  },
  "engines": { "node": ">=22" }
}
